<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.parsonlee.knowledge-bank.mail-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV_PATH__</string>
    <string>run</string>
    <string>scripts/mail_pipeline.py</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__VAULT_PATH__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>GWS_BIN</key>
    <string>__GWS_PATH__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__VAULT_PATH__/Clippings/emails/.pipeline/logs/mail-sync.out.log</string>
  <key>StandardErrorPath</key>
  <string>__VAULT_PATH__/Clippings/emails/.pipeline/logs/mail-sync.err.log</string>
</dict>
</plist>
