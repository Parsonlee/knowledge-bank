views:
  - type: table
    name: 表格
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.basename
      - file.backlinks
      - file.folder
      - file.links
    sort:
      - property: file.folder
        direction: ASC
      - property: file.backlinks
        direction: ASC
      - property: file.links
        direction: DESC
    columnSize:
      file.basename: 466
      file.backlinks: 354
      file.links: 312
  - type: table
    name: 视图
    order:
      - file.name
      - file.backlinks
      - file.links
